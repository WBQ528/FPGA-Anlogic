set_pin_assignment { key_period } { LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# Native 4-bit TF interface, board manual page 20 (external pull-ups).
set_pin_assignment { sd_dat1 } { LOCATION = B15; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { sd_dat2 } { LOCATION = A11; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# Board user switches SW1..4: manual p18; stable control inputs.
set_pin_assignment { switches[0] } { LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { switches[1] } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { switches[2] } { LOCATION = C6; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { switches[3] } { LOCATION = C5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }

# CH340 RX/TX, HX4S20 manual p11. User's sole Type-C enumerated COM11.

# R6 dedicated T1 UART: J1 pins 1/2; manual p13, schematic RN20 -> BANK1.
set_pin_assignment { hmi_rx } { LOCATION = D14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { hmi_tx } { LOCATION = G11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }

# PHY location-only additions from supplied 8_Ethernet.pdf.
# Do NOT infer safe I/O voltage from these locations. Actual FPGA bank is shown
# as 3.3V while PHY DVDDRG is shown as 2.5V; resolve before io_enable=1.
# No IOSTANDARD is invented here. Assign verified standards at integration.
set_pin_assignment {phy_mdc}   {LOCATION=L13; PULLTYPE=NONE;}
set_pin_assignment {phy_mdio}  {LOCATION=M13; PULLTYPE=NONE;}
set_pin_assignment {phy_rxc}   {LOCATION=T14; PULLTYPE=NONE;}
set_pin_assignment {phy_rxctl} {LOCATION=T13; PULLTYPE=NONE;}
set_pin_assignment {phy_rxd[0]} {LOCATION=P6; PULLTYPE=NONE;}
set_pin_assignment {phy_rxd[1]} {LOCATION=M6; PULLTYPE=NONE;}
set_pin_assignment {phy_rxd[2]} {LOCATION=T9; PULLTYPE=NONE;}
set_pin_assignment {phy_rxd[3]} {LOCATION=N9; PULLTYPE=NONE;}
set_pin_assignment {phy_txc}   {LOCATION=T12; PULLTYPE=NONE;}
set_pin_assignment {phy_txctl} {LOCATION=T7; PULLTYPE=NONE;}
set_pin_assignment {phy_txd[0]} {LOCATION=T4; PULLTYPE=NONE;}
set_pin_assignment {phy_txd[1]} {LOCATION=T6; PULLTYPE=NONE;}
set_pin_assignment {phy_txd[2]} {LOCATION=M7; PULLTYPE=NONE;}
set_pin_assignment {phy_txd[3]} {LOCATION=T8; PULLTYPE=NONE;}
